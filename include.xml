<?xml version="1.0" encoding="utf-8"?>
<extension>
	<ndll name="extension_video_export" />
	<section if="macos">
		<dependency name="OpenGL.framework"/>
	</section>
	<section if="ios">
		<dependency name="OpenGLES.framework"/>
	</section>
	<section if="macos || ios">
		<dependency name="AVFoundation.framework"/>
		<dependency name="CoreMedia.framework"/>
		<dependency name="CoreVideo.framework"/>
		<dependency name="IOSurface.framework"/>
	</section>
</extension>
