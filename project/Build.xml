<xml>
	<!-- Release optimizations: LTO (macOS/iOS/Windows/Android), dead-code strip (macOS/Linux) -->
	<set name="HXCPP_OPTIMIZE_LINK" value="1" unless="debug || fulldebug" />

	<include name="${HXCPP}/build-tool/BuildCommon.xml" />

	<set name="SRCDIR" value="${haxelib:extension-video-export}/project" />
	<set name="NATIVE" value="${haxelib:extension-video-export}/native" />

	<files id="common">
		<file name="${SRCDIR}/common/ExternalInterface.cpp" />
		<compilerflag
      value="-ffunction-sections"
      if="linux"
      unless="debug || fulldebug"
    />
		<compilerflag value="-fdata-sections" if="linux" unless="debug || fulldebug" />
	</files>

	<files id="apple">
		<compilerflag value="-objc" />
		<compilerflag value="-mmacosx-version-min=10.13" if="macos" />
		<file name="${NATIVE}/AVAssetWriterEncoder.mm" />
	</files>

	<files id="windows">
		<file name="${NATIVE}/media_foundation_encoder.cpp" />
	</files>

	<files id="android">
		<file name="${NATIVE}/mediacodec_encoder.cpp" />
	</files>

	<files id="linux">
		<file name="${NATIVE}/openh264_minimp4_encoder.c">
			<compilerflag value="-I${NATIVE}" />
		</file>
		<compilerflag value="-ffunction-sections" unless="debug || fulldebug" />
		<compilerflag value="-fdata-sections" unless="debug || fulldebug" />
	</files>

	<!-- Android: LIBEXTRA adds arch suffix (-64, -v7, etc.) needed because all archs share one dir.
	     Desktop/iOS: arch is in BINDIR (MacArm64, Windows64, etc.), no suffix needed. -->
	<set name="VE_SUFFIX" value="" />
	<set name="VE_SUFFIX" value="${LIBEXTRA}" if="android" />

	<target
    id="NDLL"
    output="${LIBPREFIX}extension_video_export${VE_SUFFIX}"
    tool="linker"
    toolid="${STD_MODULE_LINK}"
  >
		<outdir name="../ndll/${BINDIR}" />
		<ext value=".ndll" if="windows || macos || linux" />
		<ext value=".so" if="android" />
		<ext value="${LIBEXTRA}.a" if="iphoneos || iphonesim" />
		<files id="common" />

		<section if="macos || iphoneos || iphonesim">
			<files id="apple" />
			<section if="macos">
				<vflag name="-framework" value="AVFoundation" />
				<vflag name="-framework" value="CoreMedia" />
				<vflag name="-framework" value="CoreVideo" />
				<vflag name="-framework" value="IOSurface" />
				<vflag name="-framework" value="Metal" />
				<vflag name="-framework" value="OpenGL" />
				<lib name="-Wl,-dead_strip" unless="debug || fulldebug" />
			</section>
			<section unless="MACOSX_DEPLOYMENT_TARGET">
				<setenv name="MACOSX_DEPLOYMENT_TARGET" value="10.13" unless="HXCPP_ARM64" />
				<setenv name="MACOSX_DEPLOYMENT_TARGET" value="11.7" if="HXCPP_ARM64" />
			</section>
		</section>

		<section if="windows">
			<files id="windows" />
			<lib name="mfplat.lib" />
			<lib name="mfreadwrite.lib" />
			<lib name="mf.lib" />
			<lib name="mfuuid.lib" />
			<lib name="ole32.lib" />
			<lib name="d3d11.lib" />
			<lib name="dxgi.lib" />
			<lib name="opengl32.lib" />
		</section>

		<section if="android">
			<files id="android" />
			<lib name="-lmediandk" />
			<lib name="-landroid" />
			<lib name="-lEGL" />
			<lib name="-lGLESv3" />
		</section>

		<section if="linux">
			<files id="linux" />
			<lib name="-lopenh264" />
			<lib name="-Wl,--gc-sections" unless="debug || fulldebug" />
		</section>
	</target>

	<target id="default">
		<target id="NDLL" />
	</target>
</xml>
